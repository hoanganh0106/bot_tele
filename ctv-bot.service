[Unit]
Description=CTV Telegram Bot (Rust)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ctv-bot
ExecStart=/home/ubuntu/ctv-bot/bot_tele
Restart=always
RestartSec=5
Environment=DATA_DIR=/home/ubuntu/ctv-bot-data
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
